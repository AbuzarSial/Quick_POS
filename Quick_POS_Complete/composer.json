{
  "name": "abuzarsial/quick-pos",
  "description": "QuickPOS landing page with PHP validation, automated tests, and CI/CD pipeline.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "QuickPOS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "QuickPOSTests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testdox",
    "lint": "phpcs --standard=PSR12 src tests",
    "syntax": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  }
}
